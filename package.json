{
  "name": "meme-lab",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Read-only Solana meme token alerting and screening pipeline (research only, never trades).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "NODE_USE_ENV_PROXY=1 node --import tsx src/index.ts",
    "dry-run": "node --import tsx scripts/dry-run.ts",
    "backfill": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/backfill.ts run",
    "backfill:report": "node --import tsx scripts/backfill.ts report",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^3.0.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
