# Copy to .env and fill in. Never commit the real .env.
# This pipeline is READ-ONLY: no private keys, no signing, no trading.

# Solana RPC endpoint (Helius / QuickNode / Triton or any compatible RPC).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Telegram push (optional). Leave empty to log alerts to stdout instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Enable DexScreener enrichment for liquidity / market cap (no key required).
DEXSCREENER_ENABLED=true

# SQLite database file path.
MEMELAB_DB_PATH=./data/meme-lab.sqlite

# Log level: debug | info | warn | error
LOG_LEVEL=info

# NOTE: if you are behind a local proxy (e.g. 127.0.0.1:7890), Node's fetch does
# NOT read http_proxy/https_proxy by default. `npm start` sets
# NODE_USE_ENV_PROXY=1 for that reason. Add the same flag to any other entrypoint
# you run (e.g. `NODE_USE_ENV_PROXY=1 node --import tsx scripts/xxx.ts`).
